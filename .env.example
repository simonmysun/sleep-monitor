ICAL_URL='https://calendar.google.com/calendar/ical/.../.../basic.ics'
EVENT_NAME='Slept'
CACHE_EXPIRATION=300

# Data import and the dev observability stack
INFLUXDB_VERSION='2'
INFLUXDB_URL='http://localhost:8086'
INFLUXDB_ORG='sleep-monitor'
INFLUXDB_BUCKET='sleep'
INFLUXDB_TOKEN='replace-with-a-long-random-token'
# InfluxDB 1.x uses DATABASE/USERNAME/PASSWORD instead of ORG/BUCKET/TOKEN.
INFLUXDB_DATABASE='sleep'
INFLUXDB_USERNAME=''
INFLUXDB_PASSWORD=''
GRAFANA_ADMIN_USER='admin'
GRAFANA_ADMIN_PASSWORD='admin'

# One or more comma-separated local paths or http(s) URLs. ICAL_URL is used as
# a fallback when ICS_SOURCES is empty.
ICS_SOURCES=''
ICS_TITLE_PATTERN='Slept|Sleep|Nap'

HA_URL='https://home-assistant.example.com/'
HA_TOKEN=''
HA_ENTITY_IDS='sensor.bedroom_temperature,binary_sensor.bed_occupancy'
HA_CHUNK_DAYS=7

AW_EXPORT_PATH='./aw-buckets-export.json'
AW_MERGE_GAP_SECONDS=5
AW_MIN_DURATION_SECONDS=0.5

# Shared time range for ICS recurrence expansion and HA history. Defaults to
# the last 30 days when omitted.
IMPORT_START=''
IMPORT_END=''
